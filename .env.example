# Optional TURN server for restrictive cellular networks (eg coturn):
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# The only email authorized to verify and receive the protected owner role.
OWNER_EMAIL=grebenjuk13@gmail.com

# An SMTP mailbox is REQUIRED before email-based owner verification can work.
# Never commit real credentials: enter them in Render Environment variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set to 1 ONLY if CLOUX_DATA is on a persistent disk; /tmp is NEVER persistent.
CLOUX_PERSISTENT_STORAGE=0

# Persistent PostgreSQL connection supplied by your database provider.
DATABASE_URL=

# Optional TOTP: generate with Python cryptography.fernet.Fernet.generate_key()
CLOUX_TOTP_FERNET_KEY=
