# Copy this file to .env and set credentials before using Gmail registration.
# Generate CLOUX_EMAIL_PEPPER with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
CLOUX_EMAIL_PEPPER=
# Choose resend for a verified sender domain, OR smtp for Gmail App Password.
CLOUX_EMAIL_PROVIDER=resend
CLOUX_EMAIL_FROM=Cloux <hello@your-verified-domain.example>
RESEND_API_KEY=
# Alternative (Gmail App Password; NEVER your regular Google password):
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
# Optional TURN server for restrictive cellular networks (eg coturn):
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
